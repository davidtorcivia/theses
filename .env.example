# Copy to .env and fill in. These six variables are the whole bootstrap; everything
# else the app knows is configured by the owner on /settings and lives in the database.

# Address the binary listens on. Inside the container leave this as :8080: the
# published port in docker-compose.yml is what keeps it on loopback.
THESES_BIND=:8080

# Where theses.db, the markdown mirror and the thumbnail cache live.
# The container mounts the theses-data volume here.
THESES_DATA_DIR=/data

# Absolute public URL, no trailing slash. Used for links in mail, for the invite
# and reset URLs, and to decide whether session cookies get the Secure flag:
# an http:// base URL turns Secure off so local development works.
THESES_BASE_URL=https://theses.example.com

# Encrypts settings secrets (storage and SMTP credentials) at rest with AES-GCM.
# At least 32 bytes. Losing it means losing every stored secret; it cannot be
# changed without re-entering them. Generate with:
#   openssl rand -hex 32
THESES_SECRET_KEY=

# Signs session cookies, CSRF tokens and session and API token lookups.
# At least 32 bytes. Changing it signs everyone out. Generate with:
#   openssl rand -hex 32
THESES_SESSION_KEY=

# Take the client address from the rightmost X-Forwarded-For entry rather than
# from the connection. That address is what rate limiting counts against and
# what the activity log records. True is right here because a reverse proxy on
# the same host is always in front and appends it. Set it to false if the port
# is ever published anywhere but loopback, because then the header is whatever
# the caller typed and any client could choose its own rate limit bucket. No
# other forwarding header is believed either way.
THESES_TRUST_PROXY=true

# debug, info, warn or error.
THESES_LOG_LEVEL=info

# Optional, read only by docker-compose.yml.
# Host interface and port the container publishes on.
THESES_BIND_HOST=127.0.0.1
THESES_PORT=8080
# Tag for the built image and the version reported at startup.
THESES_VERSION=dev

# Passed into the container as its local time zone. Nothing in the binary's
# configuration reads it; the Go runtime does, which is what puts a local
# offset on the Date header of outgoing mail. Release times and the digest run
# on the workspace time zone set on /settings, not on this.
TZ=America/New_York

# Local development instead of Docker: point the data directory at the working
# tree, serve templates and static files from web/ rather than the embedded copy,
# and use an http base URL.
#   THESES_DATA_DIR=data
#   THESES_BASE_URL=http://localhost:8080
#   THESES_DEV=1
